global proc compCurveMovableSetup () {
	loadPlugin compCurveMovable;
	eval "createNode compCurveMovable";
	for ($ii = 0; $ii < 4; $ii++) {
		int $jj = 0;
		if ($ii == 1 || $ii == 2) {
			$jj = 3;
		}
		setAttr -type "double3" (".cp["+$ii+"]") ($ii*2) $jj 0;
	}
}
